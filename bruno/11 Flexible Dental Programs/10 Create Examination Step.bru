meta {
  name: Create Examination Step
  type: http
  seq: 10
}
post {
  url: {{baseUrl}}/api/v1/program-versions/{{programVersionId}}/steps
  body: json
  auth: none
}
headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}
body:json {
	{
		"code": "initial-examination",
		"name": "Khám và chụp CT",
		"step_type": "EXAMINATION",
		"display_order": 1,
		"is_required": true,
		"due_days": 3,
		"workflow_template_id": "{{stepWorkflowId}}"
	}
}
script:post-response {
  bru.setVar("examinationTemplateId", res.getBody().data.id);
}
tests {
  test("creates root step template", function () { expect(res.getStatus()).to.equal(201); });
}
