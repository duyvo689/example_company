meta {
  name: List Locations
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/locations?page=1&page_size=20&status=active
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("lists tenant locations", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.total).to.be.greaterThan(0);
  });
}
