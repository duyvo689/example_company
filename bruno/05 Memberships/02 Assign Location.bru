meta {
  name: Assign Location
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/memberships/{{clinicianMembershipId}}/locations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "location_id": "{{locationId}}"
  }
}

tests {
  test("assigns clinician to location", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.location_id).to.equal(bru.getVar("locationId"));
  });
}
