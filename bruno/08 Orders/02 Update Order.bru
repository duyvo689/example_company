meta {
  name: Update Order
  type: http
  seq: 2
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "processing"
  }
}

tests {
  test("updates order status", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.status).to.equal("processing");
  });
}
