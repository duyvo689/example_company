meta {
  name: List Orders
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/orders?page=1&page_size=20&location_id={{locationId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("lists orders at location", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.total).to.be.greaterThan(0);
  });
}
