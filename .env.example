APP_ENV=development
HTTP_ADDR=:8080
API_PORT=8080
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/example_company?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=true
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
INTEGRATION_WEBHOOK_URL=
OUTBOX_INTERVAL=5s
SHUTDOWN_TIMEOUT=10s
